SETUP_ENV=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cookies
COOKIE_SECURE=

# /docs Basic Auth
DOCS_USERNAME=
DOCS_PASSWORD=

# PostgreSQL
DATABASE_URL=

# Weaviate
WEAVIATE_HOST=
WEAVIATE_PORT=
WEAVIATE_GRPC_PORT=

# OpenAI
OPENAI_API_KEY=
OPENAI_TIMEOUT=60

# External API timeouts
TURNSTILE_API_TIMEOUT=10

# Rate limiting (requests per minute)
CHAT_RATE_LIMIT=20
AUTH_RATE_LIMIT=10

# Spend alerting
SPEND_ALERT_THRESHOLD=
ALERT_EMAIL=

# Hard daily spend cap (USD) — blank disables the cap
DAILY_SPEND_CAP_USD=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Phoenix observability
PHOENIX_HOST=
PHOENIX_PORT=
PHOENIX_GRPC_PORT=

# Docs / internal API Basic Auth
DOCS_USERNAME=
DOCS_PASSWORD=
