SETUP_ENV=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cookies
COOKIE_SECURE=

# PostgreSQL
DATABASE_URL=

# Weaviate
WEAVIATE_HOST=
WEAVIATE_PORT=
WEAVIATE_GRPC_PORT=

# OpenAI
OPENAI_API_KEY=
OPENAI_TIMEOUT=60

# External API timeouts
GOOGLE_API_TIMEOUT=10
TURNSTILE_API_TIMEOUT=10

# Rate limiting (requests per minute)
CHAT_RATE_LIMIT=20
AUTH_RATE_LIMIT=10

# Spend alerting
SPEND_ALERT_THRESHOLD=
ALERT_EMAIL=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Phoenix observability
PHOENIX_HOST=
PHOENIX_PORT=
PHOENIX_GRPC_PORT=
